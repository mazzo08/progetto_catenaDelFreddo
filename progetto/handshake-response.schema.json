{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake: risposta del server (session_id e B)",
  "type": "object",
  "required": ["session_id", "server_public"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "server_public": { "type": "string", "pattern": "^[0-9a-f]{1,512}$" }
  },
  "additionalProperties": false
}
